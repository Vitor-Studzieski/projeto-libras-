# URL da API/serviço que recebe um vídeo de Libras e retorna texto em português.
# A API pública da iaLibras ainda não fornece este endpoint; preencha quando
# receber a documentação/credencial do provedor escolhido.
LIBRAS_API_URL=

# base64-json envia { video, mimeType, language, source }.
# multipart envia o arquivo no campo configurado abaixo.
LIBRAS_API_STYLE=base64-json
LIBRAS_API_VIDEO_FIELD=video
LIBRAS_API_KEY=
LIBRAS_API_KEY_HEADER=Authorization
LIBRAS_API_KEY_PREFIX=Bearer 
LIBRAS_API_TIMEOUT_MS=30000

# VLibras: português do atendente → Libras.
# Serviço oficial atual. Troque pela sua instância se necessário.
VLIBRAS_API_BASE_URL=https://traducao2.vlibras.gov.br
VLIBRAS_API_TRANSLATE_METHOD=POST
VLIBRAS_API_TRANSLATE_PATH=/translate
VLIBRAS_API_VIDEO_PATH=/video
# Ativa a solicitação de geração do vídeo em Libras.
VLIBRAS_API_VIDEO_ENABLED=true
VLIBRAS_API_KEY=
VLIBRAS_API_KEY_HEADER=x-api-key
VLIBRAS_API_KEY_PREFIX=
